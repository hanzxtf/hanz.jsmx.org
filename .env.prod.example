# Copy to .env.prod (untracked) and fill in. `just setup-env` refuses to install
# a file with the placeholder values below.

# ---- required ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DJANGO_DEBUG=false
ENVIRONMENT=production
ALLOWED_HOSTS=hanz.jsmx.org,bsd.jsmx.org
CSRF_TRUSTED_ORIGINS=https://hanz.jsmx.org,https://bsd.jsmx.org
WAGTAILADMIN_BASE_URL=https://hanz.jsmx.org
WAGTAIL_SITE_NAME=Haniel Eldrid

# ---- media storage (S3 compatible) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_PUBLIC_ENDPOINT_URL=
AWS_S3_SECURE_URLS=true

# ---- mail (form notifications) ----
# Submissions are stored even when sending fails, but nobody gets told, so point
# this at a relay the server can reach. A local MTA on port 25 works as-is.
# For a hosted relay, use the SMTP credentials it gives you, and its verified
# sending domain for DEFAULT_FROM_EMAIL. Resend is:
#   EMAIL_HOST=smtp.resend.com  EMAIL_PORT=465  EMAIL_HOST_USER=resend
#   EMAIL_HOST_PASSWORD=<api key>  EMAIL_USE_SSL=true
# Port 587 with EMAIL_USE_TLS=true, EMAIL_USE_SSL=false works too. Only one of
# the two may be true (Django refuses to connect if both are), then confirm
# delivery: `just prod-mail-check you@example.com`.
DEFAULT_FROM_EMAIL=website@hanz.jsmx.org
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10

# ---- database + replication ----
DATABASE_PATH=/var/db/wagtail/database.db

LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=
LITESTREAM_PATH=database.db
LITESTREAM_ENDPOINT_URL=
LITESTREAM_REGION=
LITESTREAM_FORCE_PATH_STYLE=true

USE_X_FORWARDED_HOST=false
USE_X_FORWARDED_PORT=true
